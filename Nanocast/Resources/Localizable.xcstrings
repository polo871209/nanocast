        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat die geladene App unter Quarantäne gestellt und Nanocast konnte die Markierung nicht entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS puso la app descargada en cuarentena y Nanocast no pudo quitar la marca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS a placé l’app téléchargée en quarantaine et Nanocast n’a pas pu retirer ce marquage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSがダウンロードしたアプリを隔離したため、Nanocastはそのフラグを解除できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 다운로드한 앱을 격리했으며 Nanocast가 격리 플래그를 해제할 수 없습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS colocou o app baixado em quarentena e o Nanocast não conseguiu remover a marcação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS поместила загруженное приложение в карантин, и Nanocast не смог снять этот флаг."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 隔离了下载的 App，Nanocast 无法清除此标记。"
          }
        }
      }
    },
