          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его меню изменилось до нажатия. Выполните поиск снова и повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
