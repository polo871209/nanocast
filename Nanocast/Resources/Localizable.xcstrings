    "Press Return to finish dictating or Escape to cancel. Protected fields may refuse insertion." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke den Zeilenschalter, um das Diktat zu beenden, oder die Escape-Taste, um abzubrechen. Geschützte Felder verweigern das Einfügen möglicherweise."
          }
        },
        "es" : {
          "stringUnit" : {
