    "Built once, then kept current as files change. Indexing uses extra memory only while it runs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird einmal erstellt und danach bei Dateiänderungen aktuell gehalten. Die Indexierung benötigt nur während der Ausführung zusätzlichen Speicher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se crea una vez y después se mantiene al día a medida que cambian los archivos. La indexación solo usa memoria adicional mientras se ejecuta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créé une seule fois, puis tenu à jour au fil des modifications des fichiers. L’indexation n’utilise de mémoire supplémentaire que pendant son exécution."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度作成されると、ファイルの変更に合わせて最新の状態に保たれます。インデックス作成中のみ追加のメモリを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 빌드한 후 파일이 변경될 때마다 최신 상태로 유지됩니다. 색인 생성은 실행되는 동안에만 추가 메모리를 사용합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criado uma vez e mantido atualizado conforme os arquivos mudam. A indexação usa memória extra apenas enquanto é executada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создаётся один раз, затем обновляется при изменении файлов. Индексирование использует дополнительную память только во время работы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "构建一次，之后随文件变化保持最新。仅在运行时，索引才会占用额外内存。"
          }
        }
      }
    },
