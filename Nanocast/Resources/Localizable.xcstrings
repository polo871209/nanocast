    "Off hides all of them and stops their shortcuts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Aus“ blendet alle aus und deaktiviert ihre Kurzbefehle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está desactivado, se ocultan todos y se detienen sus atajos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé, cela les masque tous et arrête leurs raccourcis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、すべて非表示になり、それらのショートカットも無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면 모두 가려지고 단축키도 작동하지 않습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado oculta todos eles e interrompe os atalhos deles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключение скрывает их все и отключает их сочетания клавиш."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭会隐藏所有这些项目并停用其快捷键。"
          }
        }
      }
    },
