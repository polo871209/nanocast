    "It closed before the switch landed. Search again and retry." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde geschlossen, bevor der Wechsel erfolgte. Suche erneut und versuche es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerró antes de completar el cambio. Busca de nuevo y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle s’est fermée avant que le changement ne soit effectué. Relancez la recherche et réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
