          }
        }
      }
    },
    "Its menu changed before the press landed. Search again and retry." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Menü hat sich geändert, bevor der Klick erfolgte. Suche erneut und versuche es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su menú cambió antes de completar la pulsación. Busca de nuevo y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son menu a changé avant que l’action ne soit effectuée. Relancez la recherche et réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "押す前にメニューが変更されました。もう一度検索して、再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누르기가 적용되기 전에 메뉴가 변경되었습니다. 다시 검색한 후 재시도하십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
