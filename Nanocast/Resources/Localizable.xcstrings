    "Applications with unsaved changes may ask you to save." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps mit nicht gesicherten Änderungen fragen dich möglicherweise, ob du sichern möchtest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las aplicaciones con cambios sin guardar pueden pedirte que los guardes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les applications comportant des modifications non enregistrées peuvent vous demander de les enregistrer."
