    "Nanocast is ready. Set a shortcut in Settings to summon it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast ist bereit. Lege in den Einstellungen einen Kurzbefehl zum Aufrufen fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast está listo. Define un atajo en Ajustes para abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast est prêt. Définissez un raccourci dans les Réglages pour l’afficher."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocastの準備ができました。設定で呼び出すためのショートカットを設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast가 준비되었습니다. 설정에서 Nanocast를 여는 단축키를 지정하십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
