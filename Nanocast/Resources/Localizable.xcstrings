    "Allow Nanocast to control Finder in System Settings › Privacy & Security › Automation, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Nanocast in „Systemeinstellungen › Datenschutz & Sicherheit › Automation“, den Finder zu steuern, und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que Nanocast controle el Finder en Ajustes del Sistema › Privacidad y seguridad › Automatización y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Nanocast à contrôler le Finder dans Réglages Système › Confidentialité et sécurité › Automatisation, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定 › プライバシーとセキュリティ › オートメーションで、NanocastにFinderの操作を許可してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 › 개인정보 보호 및 보안 › 자동화에서 Nanocast가 Finder를 제어하도록 허용한 다음 다시 시도하십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que o Nanocast controle o Finder em Ajustes do Sistema › Privacidade e Segurança › Automação e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите Nanocast управлять Finder в разделе «Системные настройки» › «Конфиденциальность и безопасность» › «Автоматизация», затем повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置”›“隐私与安全性”›“自动化”中允许 Nanocast 控制访达，然后重试。"
          }
        }
      }
    },
    "Allow Nanocast to control the requested app in Automation settings, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
