    "Its enclosing folder isn’t writable by you, and Nanocast never asks for an administrator password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der zugehörige Ordner ist für dich nicht beschreibbar, und Nanocast fragt nie nach einem Administratorkennwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes permiso de escritura en la carpeta que la contiene, y Nanocast nunca pide una contraseña de administrador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez pas les droits d’écriture sur son dossier parent, et Nanocast ne demande jamais de mot de passe administrateur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "含まれているフォルダに書き込む権限がなく、Nanocastは管理者パスワードを要求することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포함하는 폴더에 쓸 수 있는 권한이 없으며, Nanocast는 관리자 암호를 요구하지 않습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasta que o contém não permite gravação por você, e o Nanocast nunca pede a senha de administrador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас нет прав на запись в содержащую его папку, а Nanocast никогда не запрашивает пароль администратора."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你对其所在的文件夹没有写入权限，而 Nanocast 从不索要管理员密码。"
          }
        }
      }
    },
    "Its global shortcut and launcher references go with it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der globale Kurzbefehl und die Launcher-Verweise werden ebenfalls entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su atajo global y sus referencias en el lanzador también se eliminan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son raccourci global et ses références dans le lanceur sont supprimés avec lui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのグローバルショートカットとランチャーでの参照も一緒に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전역 단축키와 런처 참조도 함께 삭제됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O atalho global e as referências no iniciador são removidos junto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вместе с ним удаляются его глобальное сочетание клавиш и ссылки на него в лаунчере."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
