    "%@ already exists. Import applies its settings here; Replace overwrites it with the current ones." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist bereits vorhanden. „Importieren“ übernimmt die Einstellungen hier; „Ersetzen“ überschreibt sie mit den aktuellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya existe. Importar aplica sus ajustes aquí; Reemplazar lo sobrescribe con los actuales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ existe déjà. « Importer » applique ses réglages ici ; « Remplacer » l’écrase avec les réglages actuels."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はすでに存在します。「読み込む」を選択するとその設定がここに適用され、「置き換える」を選択すると現在の設定で上書きされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 이미 있습니다. ‘가져오기’는 해당 설정을 여기에 적용하고, ‘교체’는 현재 설정으로 덮어씁니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ já existe. Importar aplica os ajustes dele aqui; Substituir sobrescreve o existente pelos atuais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» уже существует. «Импортировать» применит его настройки здесь; «Заменить» перезапишет его текущими."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”已存在。“导入”会将其设置应用到此处；“替换”会用当前设置覆盖它。"
          }
        }
      }
    },
