          }
        }
      }
    },
    "Its shortcut and launcher references go with it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kurzbefehl und die Launcher-Verweise werden ebenfalls entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su atajo y sus referencias en el lanzador también se eliminan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son raccourci et ses références dans le lanceur sont supprimés avec lui."
          }
