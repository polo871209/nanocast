{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast verwendet Automation nur für Systemaktionen, die du ausdrücklich ausführst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast uses automation to perform system actions you explicitly run."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast usa la automatización para realizar las acciones del sistema que ejecutas expresamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast utilise l’automatisation pour exécuter des actions dans d’autres apps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocastは、あなたが明示的に実行するシステムアクションにオートメーションを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast는 사용자가 직접 실행하는 시스템 동작을 수행할 때 자동화를 사용합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Nanocast usa automação para realizar as ações do sistema que você executa explicitamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast использует автоматизацию для выполнения системных действий, которые вы запускаете явно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast 使用自动化来执行你主动运行的系统操作。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast greift nur auf Bluetooth zu, wenn du die Aktion „Bluetooth umschalten“ ausführst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast uses Bluetooth access only when you run the Toggle Bluetooth action."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast solo accede a Bluetooth cuando ejecutas la acción de activar o desactivar Bluetooth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast accède au Bluetooth uniquement lorsque vous lancez l’action d’activation ou de désactivation du Bluetooth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocastは、Bluetoothの切り替えアクションを実行したときのみBluetoothにアクセスします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast는 Bluetooth 전환 동작을 실행할 때에만 Bluetooth에 접근합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Nanocast acessa o Bluetooth apenas quando você executa a ação de ativar ou desativar o Bluetooth."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast обращается к Bluetooth только при запуске действия переключения Bluetooth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast 仅在你运行切换蓝牙操作时访问蓝牙。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast greift auf deine Termine zu, damit du deinen Zeitplan ansehen und an Besprechungen teilnehmen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast accesses your events to show your schedule and let you join meetings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast accede a tus eventos para mostrar tu agenda y permitirte unirte a reuniones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast accède à vos calendriers pour afficher votre planning, créer des événements et rejoindre vos réunions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocastはイベントにアクセスして予定を表示し、会議に参加できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast는 일정을 표시하고 회의에 참여할 수 있도록 이벤트에 접근합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Nanocast acessa seus eventos para mostrar sua agenda e permitir que você participe de reuniões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast получает доступ к вашим событиям, чтобы показывать расписание и подключать вас к встречам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast 访问你的日程，以显示安排并让你加入会议。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast zeigt eine Kameravorschau, damit du dein Bild prüfen und ein Foto in die Zwischenablage kopieren kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast shows a camera preview so you can check yourself, and take a photo to the clipboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast muestra una vista previa de la cámara para que puedas verte y copiar una foto al portapapeles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast utilise la caméra pour afficher un aperçu vidéo et prendre des photos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocastはカメラのプレビューで身だしなみを確認したり、写真を撮ってクリップボードにコピーしたりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast는 자신의 모습을 확인하고 사진을 찍어 클립보드에 복사할 수 있도록 카메라 미리보기를 표시합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Nanocast mostra uma prévia da câmera para você conferir sua imagem e tirar uma foto para a área de transferência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast показывает изображение с камеры, чтобы вы могли проверить свой вид и скопировать снимок в буфер обмена."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast 显示相机预览，方便你查看自己的形象，并将拍摄的照片拷贝到剪贴板。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast nimmt Audio nur auf, während du das Diktat verwendest, und wandelt es auf deinem Mac in Text um."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast records audio only while you use Dictation, to transcribe it on your Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast solo graba audio mientras usas Dictado para transcribirlo en tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast enregistre l’audio uniquement lorsque vous utilisez la dictée, pour le transcrire sur votre Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocastは音声入力の使用中のみ音声を録音し、Mac上で文字に起こします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast는 받아쓰기를 사용하는 동안에만 오디오를 녹음하여 Mac에서 텍스트로 변환합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Nanocast grava áudio apenas enquanto você usa o Ditado, para transcrevê-lo no seu Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast записывает звук только во время диктовки и преобразует его в текст на вашем Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast 仅在你使用听写时录制音频，并在你的 Mac 上将其转为文字。"
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast erlaubt Erweiterungen, die du ausführst, deine Erinnerungen zu lesen und zu bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast lets extensions you run read and edit your reminders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast permite que las extensiones que ejecutas lean y editen tus recordatorios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast permet aux extensions que vous lancez de lire et de modifier vos rappels."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocastは、あなたが実行する拡張機能にリマインダーの読み取りと編集を許可します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast는 사용자가 실행하는 확장 프로그램이 미리 알림을 읽고 편집할 수 있게 합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Nanocast permite que as extensões que você executa leiam e editem seus lembretes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast позволяет запускаемым вами расширениям читать и редактировать ваши напоминания."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nanocast 允许你运行的扩展读取和编辑你的提醒事项。"
          }
        }
      }
    },
    "Nanocast Backup" : {
